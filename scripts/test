#!/usr/bin/env bash
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo not found. Please install Rust toolchain." >&2
  exit 1
fi

echo "Running tests..."
cargo test -q
status=$?
if [ $status -eq 0 ]; then
  echo "All tests passed."
else
  echo "Tests failed with status $status" >&2
fi
exit $status

