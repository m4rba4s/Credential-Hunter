#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.cargo/env"
fi

CARGO_CACHE_DIR="$REPO_ROOT/.cargo-cache"
mkdir -p "$CARGO_CACHE_DIR"
export CARGO_HOME="$CARGO_CACHE_DIR"

if [ -z "${CARGO_TARGET_DIR:-}" ]; then
  export CARGO_TARGET_DIR="$REPO_ROOT/target"
fi

run_step() {
  local name="$1"
  shift
  echo "=== ${name} ==="
  if "$@"; then
    echo "=== ${name} succeeded ==="
  else
    local status=$?
    echo "=== ${name} failed (exit ${status}) ===" >&2
    exit ${status}
  fi
}

run_step "Component check" "$SCRIPT_DIR/check-rustup-components"
run_step "Format" "$SCRIPT_DIR/format"
run_step "Lint" "$SCRIPT_DIR/lint"
run_step "License/Vulnerability policy" "$SCRIPT_DIR/deny"
run_step "Tests" "$SCRIPT_DIR/test"

echo "All checks completed successfully."
