#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CARGO_HOME="${CARGO_HOME:-$REPO_ROOT/.cargo-cache}"

if ! command -v cargo-deny >/dev/null 2>&1; then
  echo "cargo-deny not installed; skipping deny checks." >&2
  exit 0
fi

cargo deny --version
# Advisories require fetching RustSec DB; skip for offline runs.
cargo deny check bans sources licenses
